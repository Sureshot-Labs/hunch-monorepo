{
  "name": "journal-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "hunch-journal-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*-tests.ts",
    "lint": "eslint .",
    "format": "prettier -w . --ignore-path ../../.gitignore --ignore-unknown",
    "format:check": "prettier -c . --ignore-path ../../.gitignore --ignore-unknown"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "image-size": "^2.0.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.22.4"
  }
}
