{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Hunch account erasure journal, scoped storage permissions and tagged-volume snapshot expiry. Review change set before execution.",
  "Parameters": {
    "ApiRoleName": {
      "Type": "String"
    },
    "ContentWorkerRoleName": {
      "Type": "String"
    },
    "ContentBucketName": {
      "Type": "String"
    },
    "CloudFrontDistributionId": {
      "Type": "String"
    },
    "EnableJournalExpiration": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": ["false", "true"],
      "Description": "Enable only after all older manual snapshots have been reviewed/retired; journal must outlive every restorable backup."
    }
  },
  "Conditions": {
    "ExpireJournal": {
      "Fn::Equals": [
        {
          "Ref": "EnableJournalExpiration"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "ErasureJournal": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireAfterAllBackupHorizons",
              "Prefix": "account-erasure/v1/",
              "Status": {
                "Fn::If": ["ExpireJournal", "Enabled", "Disabled"]
              },
              "ExpirationInDays": 90
            }
          ]
        }
      }
    },
    "JournalTransportPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ErasureJournal"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": ["ErasureJournal", "Arn"]
                },
                {
                  "Fn::Sub": "${ErasureJournal.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ApiErasureJournalAccess": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "hunch-account-erasure-journal",
        "Roles": [
          {
            "Ref": "ApiRoleName"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["s3:PutObject", "s3:GetObject"],
              "Resource": {
                "Fn::Sub": "${ErasureJournal.Arn}/account-erasure/v1/*"
              }
            }
          ]
        }
      }
    },
    "ContentErasureAccess": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "hunch-content-version-erasure",
        "Roles": [
          {
            "Ref": "ContentWorkerRoleName"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["s3:ListBucketVersions"],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${ContentBucketName}"
              },
              "Condition": {
                "StringLike": {
                  "s3:prefix": ["content/*", "content-staging/*"]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${ContentBucketName}/content/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${ContentBucketName}/content-staging/*"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "cloudfront:CreateInvalidation",
                "cloudfront:GetInvalidation"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${CloudFrontDistributionId}"
              }
            }
          ]
        }
      }
    },
    "SnapshotLifecycleRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "dlm.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSDataLifecycleManagerServiceRole"
          }
        ]
      }
    },
    "TaggedVolumeSnapshots": {
      "Type": "AWS::DLM::LifecyclePolicy",
      "Properties": {
        "Description": "Daily Hunch tagged-volume snapshots, maximum 30 days (first-release retention policy)",
        "State": "DISABLED",
        "ExecutionRoleArn": {
          "Fn::GetAtt": ["SnapshotLifecycleRole", "Arn"]
        },
        "PolicyDetails": {
          "ResourceTypes": ["VOLUME"],
          "TargetTags": [
            {
              "Key": "HunchBackup",
              "Value": "personal-data"
            }
          ],
          "Schedules": [
            {
              "Name": "Daily30Days",
              "CreateRule": {
                "Interval": 24,
                "IntervalUnit": "HOURS",
                "Times": ["02:00"]
              },
              "RetainRule": {
                "Interval": 30,
                "IntervalUnit": "DAYS"
              },
              "TagsToAdd": [
                {
                  "Key": "HunchManagedRetention",
                  "Value": "30-days"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "AccountErasureJournalBucket": {
      "Value": {
        "Ref": "ErasureJournal"
      }
    }
  }
}
